#!/usr/bin/env bash
# Re-run cal-worktree setup for the worktree you are in. A plain `yarn install`
# runs first so a yarn.lock that is stale on main doesn't make the kit's
# `yarn install --immutable` abort setup.
set -euo pipefail
kit="$HOME/.local/share/cal-worktrees"
main=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["root"])' "$kit/config.json")

# Match the kit's install settings so this install shares node_modules via
# hardlinks instead of writing a full private copy.
export YARN_NM_MODE=hardlinks-global
export YARN_GLOBAL_FOLDER="$kit/yarn-global"
export YARN_ENABLE_GLOBAL_CACHE=true
export PATH="$kit/bin:$PATH"

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "cal-setup: run this from inside a worktree" >&2
  exit 1
}
if [ "$root" = "$main" ]; then
  echo "cal-setup: $root is the main checkout, not a worktree" >&2
  exit 1
fi

cd "$root"
yarn install
ORCA_WORKTREE_PATH="$root" ORCA_ROOT_PATH="$main" exec "$kit/cal-worktree" setup
