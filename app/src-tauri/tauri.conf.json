{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calport",
  "version": "0.4.2",
  "identifier": "com.calcom.calport",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calport",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/calport"
    ],
    "resources": {
      "binaries/calportd-linux-amd64": "calportd-linux-amd64",
      "binaries/calportd-linux-arm64": "calportd-linux-arm64"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRjgwQTIwQzRFOTQyMjMKUldRalF1bkVJQXI0MGxrUFdXL1ZZM0JwSW9rQm85ZTZnR1NlbWlPN1piUjVsUmxGMS9RM2RBeHAK",
      "endpoints": [
        "https://github.com/sean-brydon/calport/releases/latest/download/latest.json"
      ]
    }
  }
}
